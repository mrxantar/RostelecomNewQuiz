<UserControl x:Class="RostelecomNewQuiz.Views.Pages.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:components="clr-namespace:MainComponents.Components;assembly=MainComponents"
             xmlns:pages="clr-namespace:RostelecomNewQuiz.ViewModels.Pages"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance pages:MainPageViewModel}"
             x:Name="MainPage"
             Width="1080" Height="1920">
    <Grid>
        <Image Source="{Binding BackgroundImage, UpdateSourceTrigger=PropertyChanged}" Height="1404" VerticalAlignment="Top"/>
            <Border Background="#7700FF" VerticalAlignment="Bottom" Height="637" Padding="64">
                <StackPanel>
                    <TextBlock Style="{StaticResource RtBasisText}"
                           FontSize="80"
                           FontWeight="DemiBold"
                           Foreground="White"
                           Width="952" Height="185"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center">
                    <Run Text="Найди свою"/>
                    <LineBreak/>
                    <Run Text="идеальную вакансию"/>
                    </TextBlock>

                    <Button Width="952" Margin="0 223 0 0"
                        Height="106"
                        Background="#FF4F12"
                        Content="Погнали!"
                        FontFamily="{StaticResource RtBasis}"
                        FontWeight="SemiBold"
                        Foreground="White"
                        FontSize="48"
                        Command="{Binding NavigationToQuizCommand}">
                    </Button>
                </StackPanel>
            </Border>
    </Grid>

</UserControl>