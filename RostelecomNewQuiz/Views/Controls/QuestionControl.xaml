<UserControl x:Class="RostelecomNewQuiz.Views.Controls.QuestionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:RostelecomNewQuiz.Views.Controls"
             xmlns:pages="clr-namespace:RostelecomNewQuiz.Views.Pages"
             xmlns:pages1="clr-namespace:RostelecomNewQuiz.ViewModels.Pages"
             mc:Ignorable="d" 
             Width="1080" Height="1920"
             d:DataContext="{d:DesignInstance pages1:QuizPageViewModel}">
    <Grid>
        <StackPanel>
            <Image Source="{Binding QuestionImage}" Stretch="Fill"/>
            <controls:QuizControl DataContext="{Binding}"></controls:QuizControl>
        </StackPanel>
    </Grid>
</UserControl>
